---
// Import the logo image
import VectorLogo from '../../public/images/VectorLogo.png?url';

// Helper function to create proper URLs that work both locally and on server
const basePath = import.meta.env.BASE_URL || '/';

function createUrl(path: string): string {
  // Remove leading slash from path if present
  const cleanPath = path.startsWith('/') ? path.slice(1) : path;
  
  // If basePath is root, just return the path with leading slash
  if (basePath === '/') {
    return cleanPath === '' ? '/' : '/' + cleanPath;
  }
  
  // Otherwise combine basePath with path, ensuring proper slash handling
  // Remove trailing slash from basePath if it exists
  const normalizedBasePath = basePath.endsWith('/') ? basePath.slice(0, -1) : basePath;
  
  // For empty path (homepage), return basePath with trailing slash
  if (cleanPath === '') {
    return normalizedBasePath + '/';
  }
  
  // For other paths, combine with slash
  return normalizedBasePath + '/' + cleanPath;
}
