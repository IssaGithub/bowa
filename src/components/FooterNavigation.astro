---
// Get current URL to determine active page
const currentPath = Astro.url.pathname;
const basePath = import.meta.env.BASE_URL || '/';

// Helper function to create proper URLs that work both locally and on server
function createUrl(path: string): string {
  // Remove leading slash from path if present
  const cleanPath = path.startsWith('/') ? path.slice(1) : path;
  
  // If basePath is root, just return the path with leading slash
  if (basePath === '/') {
    return cleanPath === '' ? '/' : '/' + cleanPath;
  }
  
  // Otherwise combine basePath with path, ensuring proper slash handling
  // Remove trailing slash from basePath if it exists
  const normalizedBasePath = basePath.endsWith('/') ? basePath.slice(0, -1) : basePath;
  
  // For empty path (homepage), return basePath with trailing slash
  if (cleanPath === '') {
    return normalizedBasePath + '/';
  }
  
  // For other paths, combine with slash
  return normalizedBasePath + '/' + cleanPath;
}

// Normalize current path for comparison
let normalizedPath = currentPath;
if (basePath !== '/') {
  // Remove base path if present
  if (normalizedPath.startsWith(basePath)) {
    normalizedPath = normalizedPath.slice(basePath.length);
  }
}
// Ensure it starts with /
if (!normalizedPath.startsWith('/')) {
  normalizedPath = '/' + normalizedPath;
}
// Remove trailing slash unless it's root
if (normalizedPath !== '/' && normalizedPath.endsWith('/')) {
  normalizedPath = normalizedPath.slice(0, -1);
}

// Hide footer navigation on homepage (full-screen video hero)
const isHomepage = normalizedPath === '/';

// Navigation items
const navItems = [
  { label: 'home', href: createUrl(''), path: '/' },
  { label: 'shop', href: createUrl('shop'), path: '/shop' },
  { label: 'über uns', href: createUrl('about'), path: '/about' },
  { label: 'news', href: createUrl('news'), path: '/news' },
  { label: 'lookbook', href: createUrl('news/lookbook'), path: '/news/lookbook' },
  { label: 'preview', href: createUrl('news/preview'), path: '/news/preview' },
  { label: 'kontakt', href: '#', path: '/kontakt' }
];

// Check if current page matches nav item
function isActive(itemPath: string): boolean {
  if (itemPath === '/' && normalizedPath === '/') return true;
  if (itemPath !== '/' && normalizedPath === itemPath) return true;
  // For nested paths like /news/lookbook, also check if we're on a subpage
  if (itemPath !== '/' && normalizedPath.startsWith(itemPath + '/')) return true;
  return false;
}
---

{!isHomepage && (
  <footer id="stickyFooter" class="fixed bottom-0 left-0 right-0 bg-black/95 backdrop-blur-sm border-t border-gray-800 z-40 transform translate-y-0 transition-transform duration-300 ease-in-out">
    <div class="container mx-auto px-4 py-4">
      <!-- Footer Navigation -->
      <nav class="flex flex-wrap justify-center gap-x-8 gap-y-2 mb-2">
        {navItems.map(item => {
          const active = isActive(item.path);
          return (
            <a 
              href={item.href}
              class={`text-sm transition-colors hover:text-gray-300 ${
                active 
                  ? 'font-bold text-white' 
                  : 'text-gray-400'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
      
      <!-- Copyright -->
      <div class="text-center text-xs text-gray-500">
        © 2024 BOWAVE. Alle Rechte vorbehalten.
      </div>
    </div>
  </footer>
)}

<style>
  /* Ensure footer navigation links have consistent styling */
  nav a {
    text-decoration: none !important;
  }
  
  nav a:visited {
    color: inherit;
  }
  
  nav a:hover {
    text-decoration: none !important;
  }
  
  /* Ensure bold font weight is applied correctly */
  nav a.font-bold {
    font-weight: 700 !important;
  }
  
  /* Footer auto-hide styles */
  #stickyFooter {
    transition: transform 0.3s ease-in-out;
  }
  
  #stickyFooter.hidden {
    transform: translateY(100%);
  }
  
  #stickyFooter.visible {
    transform: translateY(0);
  }
</style>

<script>
  // Auto-hide footer functionality
  let hideTimeout: NodeJS.Timeout;
  let isHovered = false;
  let lastScrollY = window.scrollY;
  
  const footer = document.getElementById('stickyFooter');
  
  if (footer) {
    // Show footer initially
    footer.classList.add('visible');
    
    // Auto-hide after 3 seconds
    function scheduleHide() {
      clearTimeout(hideTimeout);
      hideTimeout = setTimeout(() => {
        if (!isHovered && footer) {
          footer.classList.add('hidden');
          footer.classList.remove('visible');
        }
      }, 3000);
    }
    
    // Show footer
    function showFooter() {
      footer?.classList.remove('hidden');
      footer?.classList.add('visible');
      scheduleHide();
    }
    
    // Mouse hover events
    footer?.addEventListener('mouseenter', () => {
      isHovered = true;
      clearTimeout(hideTimeout);
      showFooter();
    });
    
    footer?.addEventListener('mouseleave', () => {
      isHovered = false;
      scheduleHide();
    });
    
    // Scroll events - show on scroll
    let scrollTimeout: NodeJS.Timeout;
    window.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      showFooter();
      
      // Reset last scroll position after scroll ends
      scrollTimeout = setTimeout(() => {
        lastScrollY = window.scrollY;
      }, 150);
    });
    
    // Show on mouse movement near bottom
    window.addEventListener('mousemove', (e) => {
      const windowHeight = window.innerHeight;
      const mouseY = e.clientY;
      
      // Show footer when mouse is in bottom 100px of screen
      if (mouseY > windowHeight - 100) {
        showFooter();
      }
    });
    
    // Initialize auto-hide timer
    scheduleHide();
  }
</script> 